APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-haiku-4-5

ENABLE_TWILIO=false
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=replace_me
TWILIO_WEBHOOK_BASE_URL=replace_me

ENABLE_BROWSER_VOICE=true

MENU_RAW_FIXTURE_PATH=data/raw/sample_restaurant_menu.html
MENU_DATA_PATH=data/processed/menu.json
MENU_INDEX_PATH=data/index

HF_HOME=.cache/huggingface
TRANSFORMERS_CACHE=.cache/huggingface

ENABLE_DEBUG_ROUTES=true
